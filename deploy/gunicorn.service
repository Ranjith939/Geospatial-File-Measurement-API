[Unit]
Description=GeoMeasure (gunicorn)
After=network.target

[Service]
User=geomeasure
WorkingDirectory=/opt/geomeasure
EnvironmentFile=/opt/geomeasure/.env
ExecStart=/opt/geomeasure/.venv/bin/gunicorn geomeasure.wsgi:application --workers 2 --threads 4 --worker-class gthread --bind 127.0.0.1:8000 --timeout 120
Restart=on-failure

[Install]
WantedBy=multi-user.target
