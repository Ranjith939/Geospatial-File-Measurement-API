# Copy to .env. Never commit .env.

# Required unless DEBUG=True. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL=False

# sqlite:///geomeasure.db (default) or postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///geomeasure.db
MEDIA_ROOT=
LOG_LEVEL=INFO

# Upload limits
MAX_UPLOAD_MB=50
MAX_EXTRACTED_MB=500
MAX_ARCHIVE_MEMBERS=1000

# docker compose only
POSTGRES_PASSWORD=
WEB_WORKERS=2
