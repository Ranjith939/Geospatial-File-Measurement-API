# Copy this to .env and fill it in. Please don't commit your .env.

# You need this unless DEBUG=True. I generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL=False

# Leave it as sqlite:///geomeasure.db, or point it at postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///geomeasure.db
MEDIA_ROOT=
LOG_LEVEL=INFO

# Upload limits
MAX_UPLOAD_MB=50
MAX_EXTRACTED_MB=500
MAX_ARCHIVE_MEMBERS=1000

# Only used by docker compose
POSTGRES_PASSWORD=
WEB_WORKERS=2
